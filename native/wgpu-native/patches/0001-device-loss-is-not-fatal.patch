@@ -186,10 +187,19 @@ impl Drop for WGPUDeviceImpl {
         if !thread::panicking() {
             let context = &self.context;
 
-            // pre v27 this would wait for 60 seconds instead of waiting indefinitely
+            // The device is being released: its lost callback must not run any more (the
+            // final poll below can retire a destroyed device and fire wgpu-core's lost closure).
+            self.error_sink
+                .lock()
+                .device_lost_notified
+                .store(true, atomic::Ordering::SeqCst);
+
+            // pre v27 this would wait for 60 seconds instead of waiting indefinitely.
+            // A lost device (driver reset, GPU removed) fails the wait; it must still be
+            // released, so the failure is logged rather than fatal.
             match context.device_poll(self.id, wgt::PollType::wait_indefinitely()) {
                 Ok(_) => (),
-                Err(err) => handle_error_fatal(err, "WGPUDeviceImpl::drop"),
+                Err(err) => log::warn!("WGPUDeviceImpl::drop: device poll failed: {err}"),
             }
 
             context.device_drop(self.id);
@@ -253,6 +263,7 @@ impl Drop for WGPURenderBundleImpl {
 pub struct WGPURenderBundleEncoderImpl {
     context: Arc<Context>,
     encoder: *mut Option<*mut wgc::command::RenderBundleEncoder>,
+    error_sink: ErrorSink,
 }
 impl Drop for WGPURenderBundleEncoderImpl {
     fn drop(&mut self) {
@@ -372,9 +383,10 @@ impl Drop for WGPUTextureImpl {
         }
         if let Some(surface_id) = self.surface_id {
             if !self.has_surface_presented.load(atomic::Ordering::SeqCst) {
-                match self.context.surface_texture_discard(surface_id) {
-                    Ok(_) => (),
-                    Err(cause) => handle_error_fatal(cause, "wgpuTextureRelease"),
+                // Discarding fails when the device is lost (the frame could not be presented
+                // either): report it through the device's error sink instead of aborting.
+                if let Err(cause) = self.context.surface_texture_discard(surface_id) {
+                    handle_error(&self.error_sink, cause, None, "wgpuTextureRelease");
                 }
             }
         }
@@ -496,22 +508,47 @@ struct ErrorSinkRaw {
     uncaptured_handler: UncapturedErrorCallback,
     device_lost_handler: DeviceLostCallback,
     device: Weak<WGPUDeviceImpl>,
+    // Set once the device-lost callback has run (or must no longer run, when the device is
+    // released). Shared with the lost closure registered on wgpu-core's device, so the
+    // callback runs at most once per device whichever path notices the loss first.
+    device_lost_notified: Arc<atomic::AtomicBool>,
 }
 
 impl ErrorSinkRaw {
-    fn new(device_lost_handler: DeviceLostCallback, device: Weak<WGPUDeviceImpl>) -> ErrorSinkRaw {
+    fn new(
+        device_lost_handler: DeviceLostCallback,
+        device: Weak<WGPUDeviceImpl>,
+        device_lost_notified: Arc<atomic::AtomicBool>,
+    ) -> ErrorSinkRaw {
         ErrorSinkRaw {
             scopes: Vec::new(),
             uncaptured_handler: DEFAULT_UNCAPTURED_ERROR_HANDLER,
             device_lost_handler,
             device,
+            device_lost_notified,
         }
     }
 
     fn handle_error(&mut self, err: crate::Error) {
+        // WebGPU: once a device is lost it generates no further errors. Operations on a lost
+        // device fail with a mix of device-lost and validation errors (destroyed resources,
+        // unconfigured surfaces); none of them may reach the uncaptured-error handler, whose
+        // default is fatal.
+        let already_lost = self.device_lost_notified.load(atomic::Ordering::SeqCst);
+        if already_lost {
+            log::debug!("Error on a lost device (ignored): {err}");
+            return;
+        }
+
         let (typ, filter) = match err {
             crate::Error::DeviceLost { .. } => {
                 // handle device lost error early
+                if self
+                    .device_lost_notified
+                    .swap(true, atomic::Ordering::SeqCst)
+                {
+                    return;
+                }
                 if let Some(callback) = self.device_lost_handler.callback {
                     let userdata = &self.device_lost_handler.userdata;
                     let msg = err.to_string();
@@ -607,16 +644,33 @@ fn handle_error_fatal(
 
 fn handle_error(
     sink_mutex: &Mutex<ErrorSinkRaw>,
-    source: impl error::Error + Send + Sync + 'static,
+    source: impl WebGpuError + Send + Sync + 'static,
     label: Label<'_>,
     fn_ident: &'static str,
 ) {
+    // wgpu-core classifies its own errors. The source walk below cannot see a DeviceError
+    // wrapped as `#[error(transparent)]` (QueueSubmitError::Queue, SurfaceError::Device, ...):
+    // a transparent wrapper forwards source() to the inner error's source, skipping it.
+    let error_type = source.webgpu_error_type();
     let error = wgc::error::ContextError {
         fn_ident,
         source: Box::new(source),
         label: label.unwrap_or_default().to_string(),
     };
     let mut sink = sink_mutex.lock();
+    match error_type {
+        ErrorType::DeviceLost => {
+            return sink.handle_error(crate::Error::DeviceLost {
+                source: Box::new(error),
+            });
+        }
+        ErrorType::OutOfMemory => {
+            return sink.handle_error(crate::Error::OutOfMemory {
+                source: Box::new(error),
+            });
+        }
+        ErrorType::Internal | ErrorType::Validation => (),
+    }
     let mut source_opt: Option<&(dyn error::Error + 'static)> = Some(&error);
     while let Some(source) = source_opt {
         match source.downcast_ref::<wgc::device::DeviceError>() {
@@ -860,8 +914,20 @@ pub unsafe extern "C" fn wgpuAdapterRequestDevice(
     let result = context.adapter_request_device(adapter_id, &desc, None, None);
     match result {
         Ok((device_id, queue_id)) => {
+            let device_lost_notified = Arc::new(atomic::AtomicBool::new(false));
+            let lost_callback = device_lost_handler.callback;
+            let lost_userdata = utils::Userdata::new(
+                device_lost_handler.userdata.get_1(),
+                device_lost_handler.userdata.get_2(),
+            );
+            let mut device_address = 0usize;
             let device_impl = Arc::new_cyclic(|device| {
-                let mut error_sink = ErrorSinkRaw::new(device_lost_handler, device.clone());
+                device_address = device.as_ptr() as usize;
+                let mut error_sink = ErrorSinkRaw::new(
+                    device_lost_handler,
+                    device.clone(),
+                    device_lost_notified.clone(),
+                );
                 if let Some(error_callback) = error_callback {
                     error_sink.uncaptured_handler = error_callback;
                 }
@@ -876,6 +942,40 @@ pub unsafe extern "C" fn wgpuAdapterRequestDevice(
                     error_sink: error_sink.clone(),
                 }
             });
+
+            // wgpu-core loses a device on its own when the backend reports it lost (driver
+            // reset, GPU removed) and finishes a destroyed device's loss once its queue is idle.
+            // Forward both to the device-lost callback with wgpu-core's reason; the error sink
+            // reports a loss that an operation runs into first, and the shared flag keeps the
+            // callback to one call. wgpu-core may call this while holding its own locks, so the
+            // callback must not call back into wgpu.
+            let closure_notified = device_lost_notified.clone();
+            context.device_set_device_lost_closure(
+                device_id,
+                Box::new(move |reason, message| {
+                    if closure_notified.swap(true, atomic::Ordering::SeqCst) {
+                        return;
+                    }
+                    let Some(callback) = lost_callback else {
+                        return;
+                    };
+                    let reason = match reason {
+                        wgt::DeviceLostReason::Destroyed => native::WGPUDeviceLostReason_Destroyed,
+                        wgt::DeviceLostReason::Unknown => native::WGPUDeviceLostReason_Unknown,
+                    };
+                    let device = device_address as native::WGPUDevice;
+                    unsafe {
+                        callback(
+                            &device,
+                            reason,
+                            str_into_string_view(&message),
+                            lost_userdata.get_1(),
+                            lost_userdata.get_2(),
+                        );
+                    }
+                }),
+            );
+
             let device = Arc::into_raw(device_impl);
 
             callback(
@@ -958,11 +1058,13 @@ pub unsafe extern "C" fn wgpuBufferGetConstMappedRange(
     offset: usize,
     size: usize,
 ) -> *const u8 {
-    let (buffer_id, context) = {
