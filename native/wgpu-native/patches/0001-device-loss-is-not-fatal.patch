     let buf = match context.buffer_get_mapped_range(
         buffer_id,
         offset as wgt::BufferAddress,
@@ -998,7 +1105,10 @@ pub unsafe extern "C" fn wgpuBufferGetMappedRange(
         },
     ) {
         Ok((ptr, _)) => ptr,
-        Err(err) => handle_error_fatal(err, "wgpuBufferGetMappedRange"),
+        Err(err) => {
