# Where Etch's wgpu-native binaries come from. build.ps1 reads this file; VERSION names the
# Etch GitHub release that hosts the resulting archives (fetch.ps1 downloads from it).
#
# Pinned past v29.0.1.1 for gfx-rs/wgpu-native#619 (memory_hints via WGPUDeviceExtras), which no
# upstream release carries yet. Move back to upstream prebuilt releases once one does and the
# feature set below is no longer a size win (see design-decisions.md D-015).
repo = https://github.com/gfx-rs/wgpu-native.git
commit = b83eb6454f908f179a06e149ba212d57a1468ad0

# Cargo features per RID. Etch feeds wgpu WGSL only, so SPIR-V/GLSL shader input is left out.
# Windows keeps Vulkan as an escape hatch behind DX12; Linux keeps GLES for machines without Vulkan.
features.win-x64 = wgsl,dx12,vulkan
features.linux-x64 = wgsl,vulkan,gles
features.osx-arm64 = wgsl,metal
