<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Scene</RootNamespace>
    <AssemblyName>Etch.Scene</AssemblyName>
    <Description>Packed-struct scene command encoding.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1707;CA1028;CA1051;CA1711</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Etch.Scene.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\..\src\Etch.Geometry\Etch.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src-gen\Etch.Analyzers\Etch.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
</Project>
