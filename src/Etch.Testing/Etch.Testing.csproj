<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Etch.Testing</RootNamespace>
    <AssemblyName>Etch.Testing</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1051;CA1815;ET0105;CA1031;CA1724;IDE0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\Etch.Raster.Cpu\Etch.Raster.Cpu.csproj" />
    <ProjectReference Include="..\Etch.Tiling\Etch.Tiling.csproj" />
    <ProjectReference Include="..\Etch.Gpu.Compositor\Etch.Gpu.Compositor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Echostorm.SharpImage" />
  </ItemGroup>
</Project>