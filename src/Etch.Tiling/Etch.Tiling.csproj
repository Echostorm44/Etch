<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Tiling</RootNamespace>
    <AssemblyName>Etch.Tiling</AssemblyName>
    <Description>Tile size specialization types for compile-time dimension constants.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1707;CA1028;CA1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
    <ProjectReference Include="..\Etch.Scene\Etch.Scene.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src-gen\Etch.Analyzers\Etch.Analyzers.csproj" />
  </ItemGroup>
</Project>