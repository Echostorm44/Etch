<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Etch.ClipBlendGradient</RootNamespace>
    <AssemblyName>Etch.ClipBlendGradient</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1031;CA1720;CA1028;CA1008;CA1711;CA1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
  </ItemGroup>
</Project>
