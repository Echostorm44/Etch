<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.SkiaRef</RootNamespace>
    <AssemblyName>Etch.SkiaRef</AssemblyName>
    <Description>Skia reference-image generator library for Etch golden-image oracle (COR-006). Test/build-only — never shipped.</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1062;CA1303;CA1307;CA1308;CA1031;CA1815;CA1869;CA1849;ET0105;IDE0055;CA1305;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
    <ProjectReference Include="..\Etch.ClipBlendGradient\Etch.ClipBlendGradient.csproj" />
    <ProjectReference Include="..\Etch.Abstractions\Etch.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
  </ItemGroup>
</Project>
