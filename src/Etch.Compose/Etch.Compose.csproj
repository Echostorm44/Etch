<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Etch.Compose</RootNamespace>
    <AssemblyName>Etch.Compose</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same suppressions as the other GPU-facing Etch assemblies (Etch.Gpu, Etch.Gpu.Compositor):
         interop structs with public fields, enum naming, argument validation done by Panic. -->
    <NoWarn>$(NoWarn);ET0105;CA1062;CA1815;CA1031;CA1720;CA1028;CA1008;CA1711;CA1051;CA1002;CA1819;CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Etch.Compose.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Gpu\Etch.Gpu.csproj" />
    <ProjectReference Include="..\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
    <ProjectReference Include="..\Etch.Text\Etch.Text.csproj" />
    <ProjectReference Include="..\..\src-gen\Etch.Analyzers\Etch.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
