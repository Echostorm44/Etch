<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Gpu.Native</RootNamespace>
    <AssemblyName>Etch.Gpu.Native</AssemblyName>
    <Description>Native WebGPU bindings - generated by ClangSharp from wgpu-native C headers</Description>
    <EnableAotGeneratedFiles>true</EnableAotGeneratedFiles>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1062;ET0105;CA1802;CA1303;CA1307;CA1308;CA1031;CA1815;CA1869;IL2026;IL3050;CA2227;CA1002;CA1028;CA1008;CA1720;CA1707;CA5392;CA2255;CA1027;CA2225;CA1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src-gen\Etch.Analyzers\Etch.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Etch.Gpu.Native.targets" Pack="True" PackagePath="build/" />
    <None Include="build\runtime.json" Pack="True" PackagePath="build/" />
  </ItemGroup>

  <ItemGroup>
    <_WinX64Dlls Include="..\..\native\wgpu-native\win-x64\**\*.dll" />
    <_LinuxX64So Include="..\..\native\wgpu-native\linux-x64\**\*.so" />
    <_OsxArm64Dylib Include="..\..\native\wgpu-native\osx-arm64\**\*.dylib" />
  </ItemGroup>

  <ItemGroup>
    <None Include="@(_WinX64Dlls)" Pack="True" PackagePath="runtimes/win-x64/native/%(Filename)%(Extension)" />
    <None Include="@(_LinuxX64So)" Pack="True" PackagePath="runtimes/linux-x64/native/%(Filename)%(Extension)" />
    <None Include="@(_OsxArm64Dylib)" Pack="True" PackagePath="runtimes/osx-arm64/native/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copy the core native library to output so project-reference consumers receive it. -->
  <ItemGroup>
    <None Include="..\..\native\wgpu-native\win-x64\lib\wgpu_native.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>wgpu_native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\native\wgpu-native\win-x64\lib\wgpu_native.pdb" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>wgpu_native.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\native\wgpu-native\linux-x64\lib\libwgpu_native.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <Link>libwgpu_native.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\native\wgpu-native\osx-arm64\lib\libwgpu_native.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <Link>libwgpu_native.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyNativeBinaries" AfterTargets="Build">
    <PropertyGroup>
      <_EffectiveRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_EffectiveRid>
      <_EffectiveRid Condition="'$(_EffectiveRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_EffectiveRid>
      <_EffectiveRid Condition="'$(_EffectiveRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_EffectiveRid>
      <_EffectiveRid Condition="'$(_EffectiveRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</_EffectiveRid>
    </PropertyGroup>
    <ItemGroup>
      <_CurrentRidBinaries Include="..\..\native\wgpu-native\$(_EffectiveRid)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CurrentRidBinaries)"
          DestinationFiles="@(_CurrentRidBinaries->'$(OutDir)runtimes\$(_EffectiveRid)\native\%(Filename)%(Extension)')"
          Condition="'$(_EffectiveRid)' != ''" />
    <!-- Also copy the core DLL next to the managed assembly so project-reference consumers find it -->
    <ItemGroup>
      <_CoreDll Include="..\..\native\wgpu-native\$(_EffectiveRid)\lib\wgpu_native.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <_CoreDll Include="..\..\native\wgpu-native\$(_EffectiveRid)\lib\libwgpu_native.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <_CoreDll Include="..\..\native\wgpu-native\$(_EffectiveRid)\lib\libwgpu_native.so" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_CoreDll)"
          DestinationFiles="@(_CoreDll->'$(OutDir)%(Filename)%(Extension)')"
          Condition="'@(_CoreDll)' != ''" />
  </Target>

  <Target Name="CopyNativeBinariesForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_CurrentRidBinaries Include="..\..\native\wgpu-native\$(RuntimeIdentifier)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CurrentRidBinaries)"
          DestinationFiles="@(_CurrentRidBinaries->'$(PublishDir)runtimes\$(RuntimeIdentifier)\native\%(Filename)%(Extension)')"
          Condition="'$(RuntimeIdentifier)' != ''" />
  </Target>
</Project>