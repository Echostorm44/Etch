<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Strokes</RootNamespace>
    <AssemblyName>Etch.Strokes</AssemblyName>
    <Description>Parallel stroke expansion using Levien's algorithm.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1707;CA1028;CA1051;ET0108;CA1510;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
  </ItemGroup>
</Project>
