<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Etch.Effects</RootNamespace>
    <AssemblyName>Etch.Effects</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1031;CA1720;CA1028;CA1008;CA1711;CA1051;CA1062</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Echostorm.SharpImage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Gpu\Etch.Gpu.csproj" />
    <ProjectReference Include="..\Etch.Geometry\Etch.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etch.Abstractions\Etch.Abstractions.csproj" />
  </ItemGroup>
</Project>
