<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Repro</RootNamespace>
    <AssemblyName>Etch.Repro</AssemblyName>
    <Description>Scene reproducer CLI — dump, validate, and replay .etrp files</Description>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1062;ET0105;CA1802;CA1303;CA1307;CA1308;CA1031;CA1815;CA1869;IL2026;IL3050;CA2227;CA1002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Etch.Gpu\Etch.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Etch.Gpu.Native\Etch.Gpu.Native.csproj" />
  </ItemGroup>
</Project>
