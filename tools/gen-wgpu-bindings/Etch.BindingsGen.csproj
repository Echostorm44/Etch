<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.BindingsGen</RootNamespace>
    <AssemblyName>Etch.BindingsGen</AssemblyName>
    <Description>Tool to generate C# P/Invoke bindings from C headers using ClangSharpPInvokeGenerator</Description>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1062;ET0105;CA1802;CA1303;CA1307;CA1308;CA1031;CA1815;CA1869;IL2026;IL3050;CA2227;CA1002;CA1310;CA1861;CA1849;CA1305;CA2007;CA1822;CA1852;CA1865</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" />
  </ItemGroup>
</Project>