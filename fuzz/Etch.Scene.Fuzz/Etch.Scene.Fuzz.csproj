<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Etch.Scene.Fuzz</RootNamespace>
    <AssemblyName>Etch.Scene.Fuzz</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\Etch.Fuzz.Shared\Etch.Fuzz.Shared.csproj" />
  </ItemGroup>
</Project>
