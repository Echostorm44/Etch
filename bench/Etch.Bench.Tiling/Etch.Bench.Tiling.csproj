<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Bench.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Etch.Bench.Tiling</RootNamespace>
    <AssemblyName>Etch.Bench.Tiling</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1515;CA1725;IL3000;IL3053;IL2104;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Tiling\Etch.Tiling.csproj" />
    <ProjectReference Include="..\..\src\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\..\src\Etch.Geometry\Etch.Geometry.csproj" />
    <ProjectReference Include="..\Etch.Bench.Shared\Etch.Bench.Shared.csproj" />
  </ItemGroup>
</Project>
