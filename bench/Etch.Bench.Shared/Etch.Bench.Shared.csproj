<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Bench.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Etch.Bench.Shared</RootNamespace>
    <AssemblyName>Etch.Bench.Shared</AssemblyName>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);CS1591;CA1815;CA1716;CA1515</NoWarn>
  </PropertyGroup>
</Project>
