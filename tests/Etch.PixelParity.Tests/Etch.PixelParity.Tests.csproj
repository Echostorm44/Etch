<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Test.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Etch.PixelParity.Tests</RootNamespace>
    <AssemblyName>Etch.PixelParity.Tests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2007;CA1031;CA1305;ET0105;CA1812</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Etch.Testing\Etch.Testing.csproj" />
    <ProjectReference Include="..\..\src\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\..\src\Etch.Gpu.Native\Etch.Gpu.Native.csproj" />
    <ProjectReference Include="..\..\src\Etch.Gpu\Etch.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Etch.Gpu.Compositor\Etch.Gpu.Compositor.csproj" />
    <ProjectReference Include="..\..\src\Etch.Tiling\Etch.Tiling.csproj" />
    <ProjectReference Include="..\..\src\Etch.Scene\Etch.Scene.csproj" />
    <ProjectReference Include="..\..\src\Etch.Raster.Cpu\Etch.Raster.Cpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Corpus\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
