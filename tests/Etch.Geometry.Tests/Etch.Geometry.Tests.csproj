<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Test.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Etch.Geometry.Tests</RootNamespace>
    <AssemblyName>Etch.Geometry.Tests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA2007;CA1031;CA1305;ET0105;TUnit0034;CA1852;CA1307;CA1812;CA5394;CA1847</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- compile-fail/ is intentionally not compiled — it is verified by Etch.TaskVerifier. -->
    <Compile Remove="compile-fail\**" />
    <None Include="compile-fail\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Etch.Abstractions\Etch.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Etch.Primitives\Etch.Primitives.csproj" />
    <ProjectReference Include="..\..\src\Etch.Geometry\Etch.Geometry.csproj" />
  </ItemGroup>
</Project>
