{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Etch.Gpu/Etch.Gpu.csproj",
            "Etch.Scene/Etch.Scene.csproj",
            "Etch.Text/Etch.Text.csproj",
            "Etch.Effects/Etch.Effects.csproj",
            "Etch.Geometry/Etch.Geometry.csproj",
            "Etch.Tiling/Etch.Tiling.csproj",
            "Etch.Raster.Cpu/Etch.Raster.Cpu.csproj",
            "Etch.ClipBlendGradient/Etch.ClipBlendGradient.csproj",
            "Etch.Strokes/Etch.Strokes.csproj",
            "Etch.Primitives/Etch.Primitives.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": true,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "alphabetic",
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "api/.manifest"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": true,
    "noLangKeyword": false
  }
}
